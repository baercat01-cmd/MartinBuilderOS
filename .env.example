# Copy to .env in the project root, then restart the dev server (npm run dev).
# Values: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional — if edge functions run on a different Supabase project (e.g. OnSpace DB + hosted functions)
# VITE_SUPABASE_FUNCTIONS_URL=https://OTHER_PROJECT_REF.supabase.co
# VITE_SUPABASE_FUNCTIONS_ANON_KEY=OTHER_PROJECT_ANON_KEY

# Optional — PostHog internal-usage analytics (staff role-apps only; never the
# public portals). Leave unset to disable analytics entirely.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com
